[Unit]
Description=MathBank Spring Boot Application
After=network.target

[Service]
Type=simple
User=mathbank-admin
WorkingDirectory=/opt/mathbank
EnvironmentFile=/opt/mathbank/.env
ExecStart=/usr/bin/java -jar /opt/mathbank/app.jar --spring.profiles.active=prod
SuccessExitStatus=143
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
