<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mathbank.problem.mapper.TagMapper">

    <select id="findAll" resultType="com.mathbank.problem.domain.Tag">
        SELECT id, tag_type, tag_value, sort_order
        FROM tag
        ORDER BY sort_order ASC
    </select>

    <select id="findByType" parameterType="String" resultType="com.mathbank.problem.domain.Tag">
        SELECT id, tag_type, tag_value, sort_order
        FROM tag
        WHERE tag_type = #{tagType}
        ORDER BY sort_order ASC
    </select>

</mapper>
